{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@umurava-ai/shared": [
        "packages/shared/src"
      ],
      "@umurava-ai/engine": [
        "packages/engine/src"
      ]
    }
  }
}

