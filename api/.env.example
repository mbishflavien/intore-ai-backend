# Copy this file to .env and fill in the values.
# All variables are optional; defaults are shown inline.

# Google Gemini API key for live AI reasoning (falls back to offline mode when missing)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# MongoDB connection (falls back to in-memory storage when unset)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=umurava_ai

# Auth
# JWT_SECRET=change-me-in-production

# Server
# API_PORT=4000

# Local resume parser (Qwen GGUF service). Relative path or absolute dir.
# PARSER_DIR=../parser-llm
# PARSER_SERVICE_URL=http://localhost:5000

# Screening engine tuning
# SCREENING_TOP_N=10
# SCREENING_MIN_SCORE=35