# Copy this file to .env and fill in the values.
# All variables are optional; defaults are shown inline.

# Google Gemini API key for live AI reasoning (falls back to offline mode when missing)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# MongoDB connection (server refuses to boot when unset unless ALLOW_IN_MEMORY_DB=true)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=umurava_ai
# Explicit opt-in to ephemeral in-memory storage (local dev only — data wipes on restart)
# ALLOW_IN_MEMORY_DB=true

# Auth (REQUIRED outside development — server refuses the insecure fallback)
# JWT_SECRET=generate-a-long-random-secret-per-environment

# ---------- security ----------
# Cloudflare Turnstile secret: CAPTCHA after 3 failed logins and on signup. Unset = not enforced
# (lockout + backoff still apply). Local test secret (always passes):
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Shared secret with the frontend proxy (its PROXY_SECRET) so forwarded client IPs can be trusted.
# PROXY_SECRET=
# Key for encrypting 2FA secrets at rest (32+ chars). Defaults to a key derived from JWT_SECRET.
# MFA_ENCRYPTION_KEY=

# CORS allow-list (comma-separated; defaults to http://localhost:3000 + 127.0.0.1:3000)
# ALLOWED_ORIGINS=http://localhost:3000

# Server
# API_PORT=4000

# Local resume parser (Qwen GGUF service). Relative path or absolute dir.
# PARSER_DIR=../parser-llm
# PARSER_SERVICE_URL=http://localhost:5000

# Screening engine tuning
# SCREENING_TOP_N=10
# SCREENING_MIN_SCORE=35